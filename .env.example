# Copy this to .env and fill in your values.
# NEVER commit .env to git.

# Gemini API (free at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIza...

# Indian Express login cookies (export from browser via Cookie-Editor extension)
# Paste the full JSON array here on a single line
IE_COOKIES_JSON=[{"name":"...","value":"...","domain":".indianexpress.com"}]

# Gmail SMTP (use an App Password, NOT your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# Where to send the daily digest
EMAIL_TO=you@gmail.com

# Optional tuning (these are the defaults)
GEMINI_MODEL=gemini-2.0-flash
GEMINI_RPM_SLEEP=5.0
MAX_ARTICLES_PER_SECTION=15
RELEVANCE_THRESHOLD=6
TIMEZONE=Asia/Kolkata
OUTPUT_DIR=out
